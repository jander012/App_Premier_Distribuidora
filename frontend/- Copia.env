# O Vite lê a porta em ../backend/.env (PORT) para o proxy /api → backend.
# Se houver dois Node na máquina (4020 antigo + 4010 novo), o painel fala com o errado — deixe só um `npm run dev` no backend.
# Opcional: forçar alvo (deve bater com PORT do backend/.env):
VITE_API_PROXY_TARGET=premierdistribuidora.com.br:4020
VITE_BASE_URL=/
VITE_API_URL=https://premierdistribuidora.com.br