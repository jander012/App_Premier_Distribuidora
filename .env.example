NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=delivery
DB_PASSWORD=change-me
DB_DATABASE=delivery_db

JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_JWT_EXPIRES_IN=8h
CART_JWT_EXPIRES_IN=7d

PUBLIC_MENU_URL=https://seudominio.com.br
INTERNAL_API_KEY=change-me-with-at-least-24-characters
OTP_DEBUG_RETURN=false
ADMIN_LOGIN_MODE=auto
ADMIN_OTP_EXPIRES_MINUTES=10
ADMIN_OTP_DEBUG_RETURN=false
TRUST_PROXY=1

SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=usuario@seudominio.com.br
SMTP_PASSWORD="change-me"
MAIL_FROM="Premier Distribuidora <usuario@seudominio.com.br>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

WHATSAPP_PROVIDER=stub
PIX_PROVIDER=stub
LINX_PROVIDER=stub
PICKINGO_PROVIDER=stub
LINX_INTEGRATION_ENABLED=false
PICKINGO_INTEGRATION_ENABLED=false

MEDIA_UPLOAD_DIR=./uploads/media
OSRM_BASE_URL=https://router.project-osrm.org

THERMAL_PRINTER_INTERFACE=
THERMAL_PRINTER_TYPE=epson
THERMAL_PRINTER_WIDTH=48

TRUST_PROXY=0
