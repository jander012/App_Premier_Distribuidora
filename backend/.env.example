# Se outro app já usa uma porta (ex.: 4000), use outra (4020, 4010, etc.)
PORT=4020
NODE_ENV=development
DATABASE_URL=postgresql://delivery:delivery_secret@localhost:5433/delivery_db
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=8h
CLIENT_JWT_EXPIRES_IN=8h
CART_JWT_EXPIRES_IN=7d
# Chave para POST /whatsapp/* e POST /payments/* (mín. 24 caracteres). O frontend público não usa.
INTERNAL_API_KEY=local-dev-internal-key-at-least-24-chars
# Origens CORS separadas por vírgula. Vazio = http://localhost:5173 e 127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173,https://app.sua-loja.com
# Em produção defina false. Se true, o código OTP é retornado em JSON (apenas testes).
OTP_DEBUG_RETURN=true
# Base URL do cardápio (link enviado no WhatsApp)
PUBLIC_MENU_URL=http://localhost:5173
WHATSAPP_PROVIDER=stub
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PIX_PROVIDER=stub
# Rotas para taxa por km (OSRM). Em produção use seu servidor: https://github.com/Project-OSRM/osrm-backend
# OSRM_BASE_URL=https://router.project-osrm.org

# Impressão térmica (ESC/POS) a partir do painel — envio direto do backend para a impressora em rede.
# Ex.: tcp://192.168.0.50:9100  (porta raw 9100 é comum em Epson/Bematech em rede)
# THERMAL_PRINTER_INTERFACE=
# THERMAL_PRINTER_TYPE=epson
# Largura em caracteres: 48 ≈ 80mm, 32 ≈ 58mm
# THERMAL_PRINTER_WIDTH=48
